{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/cli/**/*", "src/server/**/*", "src/utils/**/*", "src/types/**/*", "src/handlers/**/*"],
  "exclude": ["src/dashboard/**/*", "**/fixtures/**"]
}

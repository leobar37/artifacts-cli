{
  "name": "@tarileo/artifacts-cli",
  "version": "0.1.0",
  "description": "CLI for managing and viewing HTML artifacts generated by Claude Code",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "pnpm run build:dashboard && pnpm run build:server",
    "build:dashboard": "tsc && vite build",
    "build:server": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "artifacts",
    "cli",
    "dashboard",
    "html",
    "viewer",
    "claude-code"
  ],
  "author": "leobar37",
  "license": "MIT",
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@hono/node-server": "^1.19.13",
    "@tanstack/react-query": "^5.97.0",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "diff": "^8.0.2",
    "esbuild": "0.27.7",
    "express": "^5.1.0",
    "hono": "^4.12.12",
    "lucide-react": "^1.8.0",
    "open": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "replicate": "^1.4.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^2.1.9"
  }
}

{
  "name": "@leobar37/artifact-cli",
  "version": "0.1.0",
  "description": "CLI for managing and viewing HTML artifacts generated by Claude Code",
  "type": "module",
  "main": "./dist/cli/index.js",
  "bin": {
    "artifact": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "pnpm run build:dashboard && pnpm run build:server",
    "build:dashboard": "tsc && vite build",
    "build:server": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "artifacts",
    "cli",
    "dashboard",
    "html",
    "viewer",
    "claude-code"
  ],
  "author": "leobar37",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@anthropic-ai/claude-agent-sdk": "^0.2.101",
    "@fal-ai/client": "^1.9.5",
    "@hono/node-server": "^1.19.13",
    "@mariozechner/pi-agent-core": "^0.73.0",
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@tanstack/react-query": "^5.97.0",
    "ai": "6.0.158",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "diff": "^8.0.2",
    "esbuild": "0.27.7",
    "express": "^5.1.0",
    "hono": "^4.12.12",
    "lucide-react": "^1.8.0",
    "open": "^10.1.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.10.0",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-grab/cli": "^0.1.32",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "bippy": "^0.5.39",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grab": "^0.1.32",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^2.1.9"
  }
}

{
  "name": "@tarileo/artifacts-cli",
  "version": "0.5.1",
  "description": "CLI for managing and viewing HTML/Markdown/MDX artifacts generated by coding agents",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "artifact": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/leobar37/artifacts-cli.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "bun run --cwd packages/store build && bun run build:dashboard && bun run build:server",
    "build:dashboard": "tsc && vite build",
    "build:server": "rm -f tsconfig.node.tsbuildinfo && tsc -p tsconfig.node.json && find dist -type d -name __tests__ -prune -exec rm -rf {} + && cp src/server/mdx-guide.mdx dist/server/mdx-guide.mdx && chmod +x dist/cli/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "bun test src/agent src/broker src/cli src/handlers src/server src/utils",
    "mock": "bun scripts/mock.ts",
    "mock:broker": "bun scripts/mock-broker.ts",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "artifacts",
    "cli",
    "dashboard",
    "html",
    "markdown",
    "mdx",
    "viewer",
    "claude-code"
  ],
  "author": "leobar37",
  "license": "MIT",
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@hono/node-server": "^1.19.13",
    "@tanstack/react-query": "^5.97.0",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.12.12",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "open": "^10.1.0",
    "react-is": "^18",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^2.15.0",
    "replicate": "^1.4.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6",
    "@tarileo/artifact-store": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^2.1.9"
  }
}
